# Option A (default): SQLite file, nothing to install. Leave DATABASE_URL commented out.
# Option B: MySQL. Create the empty database first:  CREATE DATABASE movie_ratings CHARACTER SET utf8mb4;
# If your password has special characters (@ : / #), URL-encode them.
# DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/movie_ratings?charset=utf8mb4

SECRET_KEY=change-me-to-a-long-random-string
MIN_RATING_COUNT=3
